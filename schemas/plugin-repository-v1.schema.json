{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:still:plugin-repository:v1",
  "title": "Still local repository index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 13,
        "maxLength": 256,
        "pattern": "^(?!.*[\\\\\\u0000-\\u001f\\u007f])(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+){0,7}\\.stillplugin$"
      }
    }
  }
}
