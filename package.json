{
  "name": "still-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "pnpm --filter @still/website dev",
    "build": "pnpm --filter @still/website build",
    "check": "biome check apps/website scripts/generate-website-tokens.mjs",
    "check:fix": "biome check --write apps/website scripts/generate-website-tokens.mjs",
    "typecheck": "pnpm --filter @still/website typecheck",
    "check:brand": "node scripts/check-contrast.mjs"
  },
  "devDependencies": { "@biomejs/biome": "2.5.15" }
}
